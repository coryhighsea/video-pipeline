# Resend (https://resend.com) — EMAIL_FROM must use a domain verified in Resend
RESEND_API_KEY=re_xxx
EMAIL_FROM="Your Brand <guide@yourdomain.com>"
EMAIL_REPLY_TO=you@yourdomain.com

# Password for /admin (HTTP basic auth, any username). Admin is disabled if unset.
ADMIN_PASSWORD=change-me

# Optional overrides (defaults shown)
# DATA_DIR=./data                       # SQLite lives here; mount a volume in production
# PDF_PATH=./private/lead-magnet.pdf
